migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Paquets et copies de bases construits par l'application
/travail/

# Work folder of the app when run from the sources (packages, database copies)
/work/

# Made by the tests and the video tool (screens, captures, frames)
/test/video/
/test/captures/
/test/failures/
/tool/video/vframes/
*.wav

# A project's own settings never go to Git
.env
*.local.php
